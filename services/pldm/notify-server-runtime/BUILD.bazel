load("@rules_rust//rust:defs.bzl", "rust_library")

# The single kernel-tagged piece of the notify server path: the Pigweed channel
# calls around the host-buildable notify_server::dispatch.
rust_library(
    name = "notify_server_runtime",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["kernel"],
    # Any pw_kernel userspace target (ast10x0, earlgrey, veer); not the host.
    target_compatible_with = ["@platforms//os:none"],
    visibility = ["//visibility:public"],
    deps = [
        "//services/pldm:pldm_service",
        "//services/pldm/notify-api:notify_api",
        "//services/pldm/notify-server:notify_server",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:zerocopy",
    ],
)
