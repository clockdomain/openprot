load("@rules_rust//rust:defs.bzl", "rust_library")

# The single kernel-tagged piece of the orchestrator's notify client path: the
# IPC Transport impl. Unlike //services/i2c/client-ipc it bounds every
# round-trip — see the crate docs.
rust_library(
    name = "notify_client_ipc",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["kernel"],
    # Any pw_kernel userspace target (ast10x0, earlgrey, veer); not the host.
    target_compatible_with = ["@platforms//os:none"],
    visibility = ["//visibility:public"],
    deps = [
        "//services/pldm/notify-api:notify_api",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_status/rust:pw_status",
    ],
)
