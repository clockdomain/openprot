load("@rules_rust//rust:defs.bzl", "rust_library")

# The pw_kernel-backed EventQueue. Depends on the `userspace` syscall crate,
# which only builds on-target (cortex-m / riscv), so this library is target-only
# and has no host test; its host-testable logic (the Event wire codec) lives in
# //services/lifecycle/api:wire and is covered by that crate's tests.
rust_library(
    name = "lifecycle_ipc",
    srcs = ["src/lib.rs"],
    crate_name = "openprot_lifecycle_ipc",
    crate_root = "src/lib.rs",
    edition = "2024",
    # The `userspace` syscall crate only builds for a bare-metal userspace
    # target; gate on os:none so host wildcard builds (`//...`) skip this
    # library instead of failing to compile its kernel dependencies.
    target_compatible_with = ["@platforms//os:none"],
    visibility = ["//visibility:public"],
    deps = [
        "//services/lifecycle/api:lifecycle_api",
        "//services/lifecycle/sm:lifecycle_sm",
        "//util/ipc_event_queue",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_status/rust:pw_status",
    ],
)
