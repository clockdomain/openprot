load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Platform-independent lifecycle service: the server end of the lifecycle IPC
# channel. Decodes inbound requests (via the shared api::wire codec), drives the
# StateMachine, and encodes responses. The I/O is abstracted (decode and
# dispatch are syscall-free), so the crate builds and unit-tests on the host;
# the target glue supplies the EventQueue and reads/writes the channel.
rust_library(
    name = "lifecycle_server",
    srcs = ["src/lib.rs"],
    crate_name = "openprot_lifecycle_server",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//services/lifecycle/api:lifecycle_api",
        "//services/lifecycle/sm:lifecycle_sm",
    ],
)

# Host integration test: drives the server with decoded requests and an
# in-memory queue + scripted Actions, asserting the full request -> machine ->
# response flow. No pw_kernel, no hardware.
rust_test(
    name = "lifecycle_server_integration_test",
    srcs = ["tests/server.rs"],
    crate_root = "tests/server.rs",
    edition = "2024",
    deps = [
        ":lifecycle_server",
        "//services/lifecycle/api:lifecycle_api",
        "//services/lifecycle/sm:lifecycle_sm",
    ],
)
