load("@rules_rust//rust:defs.bzl", "rust_library")
load("//target:defs.bzl", "PW_KERNEL_TARGET_COMPATIBLE_WITH")

rust_library(
    name = "orchestrator_server",
    srcs = [
        "src/lib.rs",
        "src/runtime.rs",
    ],
    crate_name = "openprot_orchestrator_server",
    edition = "2024",
    tags = ["kernel"],
    # Any pw_kernel target, in-tree or out-of-tree; never the host.
    target_compatible_with = PW_KERNEL_TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = [
        "//services/orchestrator/sm:orchestrator_sm",
        "//services/orchestrator/timer:orchestrator_timer",
        "@pigweed//pw_kernel/userspace",
    ],
)
