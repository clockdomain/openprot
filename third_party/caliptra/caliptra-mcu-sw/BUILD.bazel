    name = "mcu_rom",
    srcs = ["@caliptra_mcu_sw//:all_files"],
    compile_data = [":emulator-rom-layout.ld"],
    crate_root = "@caliptra_mcu_sw//:platforms/emulator/rom/src/main.rs",
    edition = "2021",
    rustc_flags = [
        "-A",
        "dead_code",
        "-C",
        "link-arg=-T$(location :emulator-rom-layout.ld)",
        "--cap-lints=allow",
        "--cfg",
        'target_arch="riscv32"',
        "-C",
        "panic=abort",
        "-C",
        "target-feature=+relax,+zba,+zbb,+zbc,+zbs",
        "-C",
        "force-frame-pointers=no",
        "-C",
        "relocation-model=static",
        "-C",
        "symbol-mangling-version=v0",
        "-C",
        "link-arg=-Wl,-nmagic",
        "-C",
        "link-arg=-Wl,--icf=all",
        # Match caliptra-mcu-sw's own [profile.release]/[profile.devel]
        # (Cargo.toml at the repo root; both share these 3 size-optimization
        # settings) -- Bazel doesn't read Cargo profiles, so without these
        # explicit flags this rule builds at whatever opt-level/codegen-units
        # Bazel's own compilation mode implies (no LTO, many codegen units),
        # which does not fit the fixed 64 KiB ROM region that upstream's own
        # build targets. embed-bitcode=yes is already set globally for every
        # rustc invocation via .bazelrc's --@rules_rust//:extra_rustc_flags,
        # which fat LTO here requires.
        "-C",
        "opt-level=z",
        "-C",
        "codegen-units=1",
        "-C",
        "lto=fat",
    ],
    tags = ["manual"],
    deps = [
        ":mcu_rom_common",
        ":romtime",
        "//third_party/caliptra:crate_bitfield",
        "//third_party/caliptra:crate_smlang",
        "//third_party/caliptra:crate_tock-registers",
        "//third_party/caliptra:crate_zerocopy",
        "//third_party/caliptra:crate_zeroize",
        "//third_party/caliptra/caliptra-sw:caliptra_drivers",
        "@rust_caliptra_crates//:caliptra-api",
        "@rust_caliptra_crates//:caliptra-api-types",
        "@rust_caliptra_crates//:caliptra-mcu-config",
        "@rust_caliptra_crates//:caliptra-mcu-config-emulator",
        "@rust_caliptra_crates//:caliptra-mcu-error",
        "@rust_caliptra_crates//:caliptra-mcu-image-header",
        "@rust_caliptra_crates//:caliptra-mcu-registers-generated",
        "@rust_caliptra_crates//:riscv-csr",
        "@rust_caliptra_crates//:rv32i",
    ],
)

caliptra_objcopy(
    name = "mcu_rom_bin_raw",
    src = ":mcu_rom",
    out = "mcu_rom_raw.bin",
    tags = [
        "manual",
        "no-sandbox",
    ],
)

# Host tool that reimplements upstream caliptra-mcu-sw's
# builder::rom::append_rom_digest(): pads the raw MCU ROM binary to its full
# rom_size and appends a SHA-384 digest of the preceding bytes, so the ROM's
# own cold_boot::rom_digest_integrity() self-check passes at boot. See
# src/mcu_rom_digest.rs for the full upstream cross-reference.
rust_binary(
    name = "mcu_rom_digest",
    srcs = ["src/mcu_rom_digest.rs"],
    aliases = {
        "@rust_caliptra_crates_host//:caliptra-mcu-config-emulator": "mcu_config_emulator",
    },
    edition = "2021",
    deps = [
        "@rust_caliptra_crates_host//:anyhow",
        "@rust_caliptra_crates_host//:caliptra-mcu-config-emulator",
        "@rust_caliptra_crates_host//:sha2",
    ],
)

genrule(
    name = "mcu_rom_bin",
    srcs = [":mcu_rom_bin_raw"],
    outs = ["mcu_rom.bin"],
    cmd = "$(location :mcu_rom_digest) $(location :mcu_rom_bin_raw) $@",
    tags = [
        "manual",
        "no-sandbox",
    ],
    tools = [":mcu_rom_digest"],
)
