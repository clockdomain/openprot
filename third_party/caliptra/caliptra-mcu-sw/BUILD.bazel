rust_library(
    name = "romtime",
    srcs = ["@caliptra_mcu_sw//:all_files"],
    crate_name = "caliptra_mcu_romtime",
    crate_root = "@caliptra_mcu_sw//:romtime/src/lib.rs",
    edition = "2021",
    # romtime/src/lib.rs's CRC routine uses inline `clmul` (carry-less
    # multiply) asm gated on the Zbc/Zbkc RISC-V extension. Because it's an
    # inlineable function, rustc re-lowers it in whichever downstream crate's
    # compilation unit actually calls it (see mcu_rom_common below) using
    # *that* crate's target-features -- so this crate needs the same
    # +zbc-bearing feature set mcu_rom's binary rule already enables, matching
    # what the platform's actual riscv32imc + Zbc-capable core supports.
    rustc_flags = [
        "--cap-lints=allow",
        "-C",
        "target-feature=+relax,+zba,+zbb,+zbc,+zbs",
    ],
    target_compatible_with = ["//third_party/caliptra/platforms:target_caliptra"],
    deps = [
        ":mcu_mbox_common",
        ":mcu_otp_digest",
        ":mcu_otp_fuse",
        ":mcu_otp_lifecycle",
        "//third_party/caliptra:crate_bitflags",
        "//third_party/caliptra:crate_caliptra-mcu-registers-generated",
        "//third_party/caliptra:crate_tock-registers",
        "//third_party/caliptra:crate_zerocopy",
        "@rust_caliptra_crates//:caliptra-api",
        "@rust_caliptra_crates//:caliptra-mcu-error",
        "@rust_caliptra_crates//:caliptra-registers",
        "@rust_caliptra_crates//:caliptra-ureg",
        "@rust_caliptra_crates//:riscv-csr",
    ],
)

