# Mirrors the build-wide settings openprot relies on (see ../../.bazelrc).
common --@pigweed//pw_toolchain/cc:cxx_standard=17
common --per_file_copt=external/.*,.*\.pb\.cc@-w
common --host_per_file_copt=external/.*,.*\.pb\.cc@-w
common --incompatible_default_to_explicit_init_py
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --@rules_rust//:extra_rustc_flags=-Cembed-bitcode=yes
common --@rules_rust//:extra_exec_rustc_flags=-Cembed-bitcode=yes
common --build_tag_filters=-do_not_build,-kernel_doc_test

# This module sits inside the openprot checkout; don't drop bazel-* symlinks
# into openprot's tree.
common --experimental_convenience_symlinks=ignore

# `bazel test --config=qemu //...` runs the board image under QEMU's
# ast1030-evb machine using openprot's AST10x0 harness.
common:qemu --platforms=//:example_board
common:qemu --@openprot//target/ast10x0:qemu=true
run:qemu  --run_under="@openprot//target/ast10x0/harness:qemu_runner \
  --cpu cortex-m4 --machine ast1030-evb --image "
test:qemu --run_under="@openprot//target/ast10x0/harness:qemu_runner \
  --cpu cortex-m4 --machine ast1030-evb --image "
